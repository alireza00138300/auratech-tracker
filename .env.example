# AuraTech Tracker Configuration

# Port
PORT=8000

# Database URL: Leave empty to use local SQLite (./data/auratech.db),
# or provide an external PostgreSQL / Neon / Supabase URL
DATABASE_URL=sqlite:///./data/auratech.db

# GitHub Gist Cloud Backup & Auto-Restore (Optional, Recommended for Render Free Tier)
# Generate a Personal Access Token (classic) on GitHub with "gist" scope
GITHUB_BACKUP_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_GIST_ID=yourExistingGistIdOptional

# Application Environment
APP_ENV=production
